{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "process",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/Launcher.sln",
                "/t:Build",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/Launcher.sln",
                "/t:Build",
                "/p:Configuration=Public",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Rebuild Debug",
            "type": "process",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/Launcher.sln",
                "/t:Rebuild",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/v:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Rebuild Release",
            "type": "process",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/Launcher.sln",
                "/t:Rebuild",
                "/p:Configuration=Public",
                "/p:Platform=x64",
                "/v:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
